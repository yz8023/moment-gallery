<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===================== 1. 看图页 ===================== -->
            <LinearLayout
                android:id="@+id/pageViewer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.28"
                            android:maxLines="1"
                            android:text="MOMENTS"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:letterSpacing="0.38"
                            android:text="@string/only_a_moment"
                            android:textColor="@color/text_tertiary"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/timecode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:text="00:00"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <ImageView
                        android:id="@+id/btnToGrid"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:alpha="0.85"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="平铺"
                        android:padding="9dp"
                        android:src="@drawable/ic_columns" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp">

                    <com.moment.gallery.ThumbRailView
                        android:id="@+id/rail"
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start|top" />

                    <FrameLayout
                        android:id="@+id/cardWrap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="62dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true">

                        <com.moment.gallery.PhotoCardView
                            android:id="@+id/card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/videoBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_badge"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="0:12"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="62dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:id="@+id/tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:letterSpacing="0.3"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="@string/default_tag"
                        android:textColor="#E6E6EA"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/livePill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_live"
                        android:letterSpacing="0.22"
                        android:paddingStart="7dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="4dp"
                        android:text="实况"
                        android:textColor="#0A0A0B"
                        android:textSize="8sp"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="01 / 05"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nowLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:paddingStart="62dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- ===================== 2. 平铺页 ===================== -->
            <FrameLayout
                android:id="@+id/pageGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <com.moment.gallery.GridListView
                    android:id="@+id/gridList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="6dp"
                    android:paddingTop="78dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="10dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/gridTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.26"
                    android:text="MOMENTS"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/gridCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="46dp"
                    android:letterSpacing="0.16"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/btnToViewer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.85"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="单张"
                    android:padding="9dp"
                    android:src="@drawable/ic_photo" />

                <TextView
                    android:id="@+id/timelineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_pill"
                    android:letterSpacing="0.2"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text=""
                    android:textColor="#D8D8DE"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <com.moment.gallery.FastScrollerView
                    android:id="@+id/fastScroller"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/columnsHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="4 列"
                    android:textColor="#F0F0F4"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ===================== 3. 图集页 ===================== -->
            <FrameLayout
                android:id="@+id/pageAlbums"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="26dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.26"
                        android:text="图集"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="6dp"
                        android:letterSpacing="0.14"
                        android:text="本机的相册，点一个开始看"
                        android:textColor="@color/text_tertiary"
                        android:textSize="9.5sp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="12dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/albumsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingBottom="20dp" />
                    </ScrollView>
                </LinearLayout>
            </FrameLayout>

            <!-- ===================== 4. 设置页 ===================== -->
            <ScrollView
                android:id="@+id/pageSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.26"
                        android:text="设置"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/settingsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- ===================== 底栏 ===================== -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_nav"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navPhotos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navPhotosIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_photo" />

                <TextView
                    android:id="@+id/navPhotosText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="图片"
                    android:textColor="#F0F0F4"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAlbums"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navAlbumsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:alpha="0.45"
                    android:src="@drawable/ic_folder" />

                <TextView
                    android:id="@+id/navAlbumsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="图集"
                    android:textColor="#6B6B73"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:alpha="0.45"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/navSettingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="设置"
                    android:textColor="#6B6B73"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
